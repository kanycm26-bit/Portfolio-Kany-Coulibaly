function initMotif(sectionId){
  const sec=document.getElementById(sectionId);
  if(!sec)return;
  const pieces=[...sec.querySelectorAll('.motif-piece')];
  sec.addEventListener('pointermove',e=>{
    const r=sec.getBoundingClientRect();
    const dx=(e.clientX-r.left)/r.width-0.5,dy=(e.clientY-r.top)/r.height-0.5;
    pieces.forEach(p=>{const depth=parseFloat(p.dataset.depth)||10;p.style.transform=`translate(${(dx*depth).toFixed(1)}px,${(dy*depth).toFixed(1)}px)`;});
  });
  sec.addEventListener('pointerleave',()=>pieces.forEach(p=>p.style.transform=''));
}
