window.anxEdDem=pi=>{
  const inp=document.getElementById('anx-lbl-'+pi);
  const lbl=(inp.value||'').trim()||'Pièce non numérisée';
  PROJECTS[pi].annexes.push({label:lbl,kind:'doc',src:null});
  inp.value='';persistProj();renderEdAnx();
};
window.anxEdFile=(pi,input)=>{
  const file=input.files[0];if(!file)return;
  const inp=document.getElementById('anx-lbl-'+pi);
  const lbl=(inp.value||'').trim()||file.name.replace(/\.[^.]+$/,'');
  const r=new FileReader();
  r.onload=e=>{
    PROJECTS[pi].annexes.push({label:lbl,kind:file.type==='application/pdf'?'pdf':'image',src:e.target.result});
    inp.value='';persistProj();renderEdAnx();
  };
  r.readAsDataURL(file);
};

function openEditor(){
  const v=(id,val)=>document.getElementById(id).value=val;
  v('e-name',document.getElementById('logo').textContent.trim().replace(/\s+/g,' '));
  v('e-a1',document.getElementById('a-1').textContent);
  v('e-a2',document.getElementById('a-2').textContent);
  v('e-a3',document.getElementById('a-3').textContent);
  v('e-pf-dev',document.getElementById('pf-dev').textContent);
  v('e-pf-pro',document.getElementById('pf-pro').textContent);
  v('e-pf-reseau',document.getElementById('pf-reseau').textContent);
  v('e-cc-resume',document.getElementById('cc-resume').textContent);
  v('e-cc-analyse',document.getElementById('cc-analyse').textContent);
  v('e-ct-email',document.getElementById('ct-email').getAttribute('href').replace('mailto:',''));
  v('e-ct-linkedin',document.getElementById('ct-linkedin').getAttribute('href'));
  v('e-ct-loc',document.getElementById('ct-loc').textContent);
  const c=document.getElementById('ep-proj');c.innerHTML='';
  PROJECTS.forEach((p,i)=>{
    const d=document.createElement('div');
    d.innerHTML=`<div class="ed-sub">Projet ${esc(p.n)}</div>
      <div class="ed-field"><label>Titre</label><input type="text" id="e-pt${i}"></div>
      <div class="ed-field"><label>Sous-titre</label><input type="text" id="e-ps${i}"></div>
      <div class="ed-field"><label>Description</label><textarea id="e-pd${i}"></textarea></div>
      <div class="ed-field"><label>Tags (séparés par des virgules)</label><input type="text" id="e-ptg${i}"></div>`;
    c.appendChild(d);
    v('e-pt'+i,p.title);v('e-ps'+i,p.sub||'');v('e-pd'+i,p.desc);v('e-ptg'+i,(p.tags||[]).join(', '));
  });
  renderEdAnx();
  renderEdViews();
  document.getElementById('editor').classList.add('open');
}
window.applyEdits=(silent)=>{
  const val=id=>document.getElementById(id).value;
  const name=val('e-name')||'Kany Coulibaly';
  const parts=name.split(' ');
  document.getElementById('logo').innerHTML=parts.length>1?esc(parts.slice(0,-1).join(' '))+' <em>'+esc(parts[parts.length-1])+'</em>':esc(name);
  document.querySelector('.foot-name').textContent=name;
  document.getElementById('a-1').textContent=val('e-a1');
  document.getElementById('a-2').textContent=val('e-a2');
  document.getElementById('a-3').textContent=val('e-a3');
  document.getElementById('pf-dev').textContent=val('e-pf-dev');
  document.getElementById('pf-pro').textContent=val('e-pf-pro');
  document.getElementById('pf-reseau').textContent=val('e-pf-reseau');
  document.getElementById('cc-resume').textContent=val('e-cc-resume');
  document.getElementById('cc-analyse').textContent=val('e-cc-analyse');
  const em=val('e-ct-email');
  const ea=document.getElementById('ct-email');
  ea.setAttribute('href','mailto:'+em);
  ea.querySelector('span:last-child').textContent=em;
  let lk=val('e-ct-linkedin').trim();
  const oldLk=document.getElementById('ct-linkedin').getAttribute('href')||'';
  if(/^[a-z][a-z0-9+.-]*:/i.test(lk)&&!/^https?:\/\//i.test(lk))lk=oldLk;
  else if(lk&&!/^https?:\/\//i.test(lk))lk='https://'+lk.replace(/^\/+/,'');
  if(!lk)lk=oldLk;
  document.getElementById('ct-linkedin').setAttribute('href',lk||'#');
  document.getElementById('ct-linkedin').querySelector('span:last-child').textContent=lk.replace(/^https?:\/\//,'');
  document.getElementById('ct-loc').textContent=val('e-ct-loc');
  PROJECTS.forEach((p,i)=>{
    p.title=val('e-pt'+i);p.sub=val('e-ps'+i);p.desc=val('e-pd'+i);
    p.tags=val('e-ptg'+i).split(',').map(s=>s.trim()).filter(Boolean);
  });
  delete phCache.couloir;
  if(galleryOpen&&xpCur)setView(xpCur);
  persistProj();
  renderVisitList();
  if(smoothOn)setBodyH();
  if(!silent)alert('✓ Modifications appliquées. Clique « Exporter HTML » pour sauvegarder le fichier.');
};
window.exportHTML=()=>{
  applyEdits(true);
  closeEditor();closeGate();
  // remet la page dans son état initial avant sérialisation
  const restores=[];
  const rmCls=(el,cls)=>{if(el&&el.classList.contains(cls)){restores.push(()=>el.classList.add(cls));el.classList.remove(cls);}};
  rmCls(document.getElementById('loader'),'gone');
  rmCls(document.body,'loaded');rmCls(document.body,'ed-on');
  ['overlay','sheetBackdrop','panel','gate','editor','lightbox'].forEach(id=>{const el=document.getElementById(id);rmCls(el,'open');rmCls(el,'show');});
  const wt=wrap.style.transform,wh=wrap.style.position,bh=document.body.style.height;
  wrap.style.transform='';wrap.style.position='';document.body.style.height='';
  const html='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
  restores.forEach(f=>f());
  if(smoothOn){wrap.style.position='fixed';wrap.style.transform=wt;document.body.style.height=bh;}
  const blob=new Blob([html],{type:'text/html'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='portfolio-kany-coulibaly.html';a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),2000);
};
</script>


