#editor.open{display:flex;}
.ed-head{display:flex;justify-content:space-between;align-items:center;padding:1.15rem 1.5rem;border-bottom:.5px solid var(--line);background:var(--sand-pale);}
.ed-head h3{font-family:var(--serif);font-size:1.15rem;font-weight:400;color:var(--ink);}
.ed-close{background:none;border:none;font-size:1.5rem;color:var(--text-muted);cursor:pointer;}
.ed-tabs{display:flex;flex-wrap:wrap;gap:2px;padding:.85rem 1.5rem 0;}
.ed-tab{padding:.42rem .8rem;font-size:.62rem;text-transform:uppercase;letter-spacing:.08em;border:.5px solid var(--line);background:none;cursor:pointer;color:var(--text-muted);}
