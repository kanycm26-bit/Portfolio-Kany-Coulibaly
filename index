.edv-imgrow{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin:.4rem 0 .8rem;}
.edv-state{font-size:.66rem;color:var(--text-muted);letter-spacing:.04em;}
.edv-btn{padding:.5rem .9rem;border:.5px solid var(--sand);background:var(--sand-pale);color:var(--terra-ink);font-size:.64rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;font-family:var(--sans);transition:all .2s;}
.edv-btn:hover{border-color:var(--terra);background:var(--white);}
.edv-hot{display:flex;align-items:flex-end;gap:.45rem;flex-wrap:wrap;padding:.55rem;border:.5px solid var(--line);background:rgba(255,255,255,.5);margin-bottom:.45rem;}
.edv-num{font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);}
.edv-num input{display:block;width:64px;margin-top:.2rem;padding:.35rem .4rem;border:.5px solid var(--line);background:var(--white);font-size:.78rem;font-family:var(--sans);}
.edv-sel{font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);flex:1;min-width:150px;}
