function bindAnnexes(p,root){
  const viewable=()=>p.annexes.filter(a=>a.src);
  root.querySelectorAll('.anx[data-i]').forEach(el=>{
    const open=()=>{
      const a=p.annexes[+el.dataset.i];
      const list=viewable();
      openLightbox(list,list.indexOf(a));
    };
    el.addEventListener('click',e=>{if(e.target.closest('[data-rm],[data-dl]'))return;open();});
    el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});
  });
  root.querySelectorAll('[data-dl]').forEach(btn=>btn.addEventListener('click',e=>{
    e.stopPropagation();
    const a=p.annexes[+btn.dataset.dl];
    if(!a||!a.src)return;
    const lk=document.createElement('a');
    lk.href=a.src;
    lk.download=(a.label||'annexe').replace(/[\\/:*?"<>|]+/g,'').trim().slice(0,80)+'.pdf';
    document.body.appendChild(lk);lk.click();lk.remove();
  }));
  root.querySelectorAll('[data-rm]').forEach(btn=>btn.addEventListener('click',e=>{
    e.stopPropagation();
    if(!confirm('Supprimer cette annexe ?'))return;
    p.annexes.splice(+btn.dataset.rm,1);persistProj();openProject(curPanel.idx,curPanel.fromGallery,true);
  }));
  const inp=root.querySelector('[data-addanx]');
  if(inp)inp.addEventListener('change',()=>{
    [...inp.files].forEach(file=>{
      const r=new FileReader();
      r.onload=e=>{
        p.annexes.push({label:file.name.replace(/\.[^.]+$/,''),kind:file.type==='application/pdf'?'pdf':'image',src:e.target.result});
        persistProj();openProject(curPanel.idx,curPanel.fromGallery,true);
      };
      r.readAsDataURL(file);
    });
  });
  const dem=root.querySelector('[data-adddem]');
  if(dem)dem.addEventListener('click',()=>{
    const lbl=prompt('Nom de la pièce disponible sur demande :','Pièce non numérisée');
    if(lbl===null)return;
    p.annexes.push({label:lbl.trim()||'Pièce non numérisée',kind:'doc',src:null});
    persistProj();openProject(curPanel.idx,curPanel.fromGallery,true);
  });
}
