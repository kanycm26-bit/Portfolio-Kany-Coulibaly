.gate-box{background:var(--white);padding:2.4rem;width:320px;border:.5px solid var(--line);display:flex;flex-direction:column;gap:1rem;}
.gate-box h3{font-family:var(--serif);font-size:1.4rem;font-weight:300;color:var(--ink);}
.gate-box p{font-size:.78rem;color:var(--text-muted);line-height:1.55;}
.gate-box input{padding:.65rem .9rem;border:.5px solid var(--line);background:var(--sand-pale);font-size:.9rem;font-family:var(--sans);}
