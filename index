.anx-off:hover{transform:none;border-color:var(--line);}
.anx-badge{font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;color:var(--patina);border:.5px solid var(--patina);padding:.22rem .5rem;border-radius:99px;}
.anx-rm{position:absolute;top:3px;right:3px;width:19px;height:19px;background:rgba(23,16,9,.78);color:#fff;border:none;border-radius:50%;font-size:.72rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2;}
.anx-dl{position:absolute;top:3px;left:3px;width:21px;height:21px;background:var(--terra-ink,#9a4a2c);color:#fff;border:none;border-radius:50%;font-size:.78rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2;opacity:.85;transition:opacity .2s,transform .2s;}
.anx-dl:hover{opacity:1;transform:scale(1.12);}
.anx-add{grid-column:1/-1;display:flex;align-items:center;justify-content:center;gap:.6rem;font-size:.66rem;color:var(--terra-ink);text-transform:uppercase;letter-spacing:.08em;padding:.6rem;border:1px dashed var(--sand);cursor:pointer;text-align:center;background:none;transition:all .25s;}
.anx-add:hover{border-color:var(--terra);background:rgba(168,85,46,.05);}
.anx-add input{display:none;}
.p-img-add{display:flex;align-items:center;justify-content:center;font-size:.68rem;color:var(--terra-ink);text-transform:uppercase;letter-spacing:.06em;padding:.6rem;border:1px dashed var(--sand);cursor:pointer;text-align:center;}
.p-img-add input{display:none;}
.ed-only{display:none !important;}
body.ed-on .ed-only{display:flex !important;}
.p-actions{display:flex;gap:.7rem;margin-top:2rem;flex-wrap:wrap;}
.p-btn{padding:.8rem 1.5rem;background:var(--terra);color:var(--white);border:none;cursor:pointer;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;transition:background .25s;}
.p-btn:hover{background:var(--terra-ink);}
.p-btn.ghost{background:none;border:.5px solid var(--sand);color:var(--terra-ink);}
.p-btn.ghost:hover{border-color:var(--terra);background:rgba(168,85,46,.05);}

/* ===== GALERIE 3D ===== */
#overlay{position:fixed;inset:0;z-index:50;background:#E7DCC9;opacity:0;visibility:hidden;transition:opacity .55s ease,visibility .55s;}
#overlay.open{opacity:1;visibility:visible;}
.xp-stage{position:absolute;inset:0;overflow:hidden;}
.xp-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;will-change:transform,opacity;}
.xp-img.on{opacity:1;}
.xp-img.in-start{transform:scale(1.05);filter:blur(7px);}
.xp-img.in-start-rev{transform:scale(1.22);filter:blur(7px);}
.xp-img.in{transition:transform .82s var(--ease-soft),filter .82s ease;transform:scale(1);filter:blur(0);}
.xp-img.out{transition:transform .82s var(--ease-soft),opacity .82s ease,filter .82s ease;transform:scale(1.35);opacity:0;filter:blur(5px);}
.xp-img.out-rev{transition:transform .82s var(--ease-soft),opacity .82s ease,filter .82s ease;transform:scale(0.85);opacity:0;filter:blur(5px);}
.xp-hotspots{position:absolute;inset:0;transition:opacity .3s;}
.xp-hotspots.fade{opacity:0;pointer-events:none;}
.xp-hot{position:absolute;min-width:44px;min-height:44px;background:transparent;border:none;cursor:pointer;border-radius:10px;padding:0;container-type:size;}
.xp-plate{position:absolute;bottom:-4%;left:50%;transform:translateX(-50%);pointer-events:none;font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(11px,26cqw,17px);line-height:1;color:var(--sand-pale);background:rgba(28,21,16,.68);border:1px solid rgba(201,162,39,.55);padding:.28em .75em;border-radius:2px;letter-spacing:.06em;box-shadow:0 2px 6px rgba(0,0,0,.3);backdrop-filter:blur(2px);}
.xp-hot::before{content:'';position:absolute;inset:0;border-radius:10px;border:1.5px dashed rgba(251,248,242,0);background:rgba(245,238,228,0);transition:box-shadow .35s,border-color .35s,background .35s;}
.xp-hot:hover::before,.xp-hot:focus-visible::before{border-color:rgba(251,248,242,.75);background:rgba(245,238,228,.14);box-shadow:0 0 0 2px rgba(251,248,242,.4),0 0 42px 8px rgba(232,200,168,.5),inset 0 0 30px rgba(251,248,242,.22);}
.xp-hot:focus-visible{outline:2px solid var(--terra);outline-offset:3px;}
.xp-tip{position:absolute;bottom:calc(100% + 10px);left:50%;transform:translate(-50%,4px);background:var(--ink);color:var(--sand-pale);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;padding:.45rem .85rem;border-radius:2px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:5;}
.xp-hot:hover .xp-tip,.xp-hot:focus-visible .xp-tip{opacity:1;transform:translate(-50%,0);}
.xp-tip.tip-below{bottom:auto;top:calc(100% + 10px);}
.zones-on .xp-hot::before{border-color:rgba(251,248,242,.85);background:rgba(245,238,228,.13);animation:xpPulse 2.4s ease-in-out infinite;}
.zones-on .xp-tip{opacity:1;transform:translate(-50%,0);}
@keyframes xpPulse{0%,100%{box-shadow:0 0 0 2px rgba(168,85,46,.35),0 0 26px 3px rgba(232,200,168,.35);}50%{box-shadow:0 0 0 3px rgba(168,85,46,.55),0 0 44px 9px rgba(232,200,168,.55);}}
.xp-crumb{position:absolute;top:1.75rem;right:1.8rem;z-index:8;display:flex;align-items:center;gap:.5rem;font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;color:#5a4a34;background:rgba(251,248,242,.72);border:.5px solid var(--line);padding:.45rem .9rem;backdrop-filter:blur(6px);}
.xp-crumb em{font-style:normal;color:var(--terra);}
.xp-crumb .sep{opacity:.45;}
.xp-visit{position:absolute;top:4.15rem;right:1.8rem;z-index:8;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:#5a4a34;background:rgba(251,248,242,.72);border:.5px solid var(--line);padding:.4rem .9rem;backdrop-filter:blur(6px);transition:background .3s,color .3s;}
.xp-visit.done{background:var(--terra);color:var(--white);border-color:var(--terra);}
.xp-hot.seen::after{content:'✓';position:absolute;top:-9px;right:-9px;width:22px;height:22px;border-radius:50%;background:var(--terra);color:var(--white);font-size:.62rem;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 6px rgba(0,0,0,.35);}
.xp-map{position:absolute;top:7rem;right:1.8rem;z-index:8;width:172px;background:rgba(251,248,242,.78);border:.5px solid var(--line);backdrop-filter:blur(8px);padding:.6rem .6rem .7rem;}
.xm-title{font-size:.52rem;letter-spacing:.22em;text-transform:uppercase;color:#5a4a34;text-align:center;margin-bottom:.5rem;}
.xp-map{cursor:grab;touch-action:none;}
.xp-map.dragging{cursor:grabbing;}
.xp-map.hidden{display:none;}
.xm-close{position:absolute;top:.1rem;right:.15rem;background:none;border:none;color:#5a4a34;font-size:.58rem;line-height:1;cursor:pointer;padding:.25rem .35rem;opacity:.6;transition:opacity .2s;}
.xm-close:hover{opacity:1;}
.xm-flabel{display:block;font-size:.48rem;letter-spacing:.16em;text-transform:uppercase;color:var(--text-muted);margin:.35rem 0 .2rem;}
.xm-grid{display:grid;gap:2px;}
.xm-etage{grid-template-columns:0.7fr 1fr 1.3fr;grid-template-areas:"esc pal bur";}
.xm-rdc{grid-template-columns:1fr 1fr 0.9fr;grid-template-areas:"gal gal ter" "hall sal ter" "fac fac .";}
.xm-grid button{border:.5px solid rgba(90,74,52,.45);background:rgba(255,255,255,.55);color:var(--terra-ink);font-size:.48rem;letter-spacing:.06em;text-transform:uppercase;font-family:var(--sans);padding:.5rem .1rem;cursor:pointer;transition:background .2s,color .2s;min-height:30px;}
.xm-grid button.xm-ext{border-style:dashed;background:rgba(255,255,255,.25);}
.xm-grid button:hover{background:var(--sand);}
.xm-grid button.cur{background:var(--terra);color:var(--white);border-color:var(--terra);}

.xp-hint{position:absolute;top:4.6rem;left:50%;transform:translateX(-50%);z-index:8;font-size:.66rem;letter-spacing:.05em;color:var(--sand-pale);background:rgba(28,21,16,.55);border:.5px solid rgba(183,167,136,.3);padding:.5rem 1rem;backdrop-filter:blur(6px);transition:opacity .5s;text-align:center;max-width:90vw;pointer-events:none;}
.xp-help{position:absolute;bottom:6.2rem;left:50%;transform:translate(-50%,12px);z-index:9;font-size:.68rem;letter-spacing:.04em;color:#fdf6ea;background:rgba(122,58,32,.88);border:.5px solid rgba(251,232,205,.35);padding:.6rem 1.15rem;border-radius:999px;backdrop-filter:blur(6px);text-align:center;max-width:88vw;opacity:0;visibility:hidden;cursor:pointer;transition:opacity .45s ease,transform .45s ease,visibility .45s;}
.xp-help.show{opacity:1;visibility:visible;transform:translate(-50%,0);}
.xp-help::before{content:'✦';margin-right:.5rem;opacity:.8;}
@media(prefers-reduced-motion:reduce){.xp-help{transition:opacity .2s,visibility .2s;transform:translate(-50%,0);}}
.xp-bar{position:absolute;bottom:1.6rem;left:1.6rem;z-index:8;display:flex;gap:.5rem;}
.xp-bar button{height:48px;padding:0 1.1rem;display:flex;align-items:center;gap:.4rem;background:rgba(251,248,242,.92);border:.5px solid var(--sand);color:var(--terra-ink);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;backdrop-filter:blur(4px);border-radius:2px;transition:all .2s;font-family:var(--sans);}
.xp-bar button:hover{background:var(--white);border-color:var(--terra);}
.xp-bar button[aria-pressed="true"]{background:var(--terra);color:var(--white);border-color:var(--terra);}
.xp-bar button.off{opacity:.45;pointer-events:none;}
.xp-vol{display:flex;align-items:center;padding:0 .8rem;background:rgba(251,248,242,.92);border:.5px solid var(--sand);backdrop-filter:blur(4px);border-radius:2px;}
.xp-vol input{width:86px;accent-color:var(--terra);cursor:pointer;}
.xp-skip{position:absolute;bottom:1.6rem;left:50%;transform:translateX(-50%);z-index:31;padding:.85rem 1.5rem;background:rgba(28,21,16,.62);border:.5px solid rgba(251,248,242,.4);color:var(--sand-pale);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;backdrop-filter:blur(6px);opacity:0;visibility:hidden;transition:opacity .4s;font-family:var(--sans);}
.xp-skip.show{opacity:1;visibility:visible;}
.xp-skip:hover{background:rgba(28,21,16,.85);}
.gal-word{position:absolute;top:1.6rem;left:1.8rem;z-index:8;font-family:var(--serif);font-size:1.25rem;font-style:italic;color:#5a4a34;pointer-events:none;}
.xp-title{position:absolute;inset:0;z-index:30;background:#171009;display:flex;align-items:center;justify-content:center;text-align:center;opacity:0;pointer-events:none;transition:opacity .9s ease;}
.xp-title.show{opacity:1;pointer-events:auto;}
.xt-inner{padding:2rem;}
.xt-kicker{font-size:.6rem;letter-spacing:.34em;text-transform:uppercase;color:#b3906a;margin-bottom:1.6rem;opacity:0;transform:translateY(10px);}
.xt-name{font-family:var(--serif);font-weight:300;font-size:clamp(2.6rem,6vw,4.6rem);color:#f4ead9;line-height:1.05;opacity:0;transform:translateY(12px);}
.xt-name em{color:#c8734a;}
.xt-line{width:52px;height:1px;background:#8a6a45;margin:1.5rem auto;opacity:0;}
.xt-sub{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:#9d8768;opacity:0;transform:translateY(8px);}
.xp-title.show .xt-kicker{animation:xtUp .8s ease .15s forwards;}
.xp-title.show .xt-name{animation:xtUp .9s ease .4s forwards;}
.xp-title.show .xt-line{animation:xtUp .7s ease .75s forwards;}
.xp-title.show .xt-sub{animation:xtUp .8s ease .95s forwards;}
@keyframes xtUp{to{opacity:1;transform:translateY(0);}}
@media(prefers-reduced-motion:reduce){
  .xp-title{transition:opacity .3s ease;}
  .xp-title.show .xt-kicker,.xp-title.show .xt-name,.xp-title.show .xt-line,.xp-title.show .xt-sub{animation:none;opacity:1;transform:none;}
}
.exit-btn{position:absolute;bottom:1.6rem;right:1.6rem;z-index:8;padding:.85rem 1.5rem;background:rgba(251,248,242,.92);border:.5px solid var(--sand);color:var(--terra-ink);cursor:pointer;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;backdrop-filter:blur(4px);transition:all .2s;}
.exit-btn:hover{background:var(--white);border-color:var(--terra);}

/* ===== LIGHTBOX ===== */
#lightbox{position:fixed;inset:0;z-index:99;background:rgba(20,14,9,.95);display:none;align-items:center;justify-content:center;flex-direction:column;opacity:0;transition:opacity .35s ease;}
