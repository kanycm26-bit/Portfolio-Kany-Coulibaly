let audioCtx=null,ambGain=null,masterGain=null,soundOn=true,vol=1;
window.xpSetVolume=v=>{
  vol=Math.pow((+v)/60,1.5);
  if(masterGain&&audioCtx)masterGain.gain.setTargetAtTime(vol,audioCtx.currentTime,0.05);
};
function noiseBuffer(ctx,secs){
  const b=ctx.createBuffer(1,ctx.sampleRate*secs,ctx.sampleRate),d=b.getChannelData(0);
  for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;
  return b;
}
function initAudio(){
  if(audioCtx)return;
  const AC=window.AudioContext||window.webkitAudioContext;
  if(!AC)return;
  audioCtx=new AC();
  masterGain=audioCtx.createGain();masterGain.gain.value=vol;masterGain.connect(audioCtx.destination);
  ambGain=audioCtx.createGain();ambGain.gain.value=0;ambGain.connect(masterGain);
  const nb=noiseBuffer(audioCtx,3);
  // brise légère
  const wind=audioCtx.createBufferSource();wind.buffer=nb;wind.loop=true;
  const wf=audioCtx.createBiquadFilter();wf.type='lowpass';wf.frequency.value=380;
  ambWind=audioCtx.createGain();ambWind.gain.value=0.5;
  const lfo=audioCtx.createOscillator();lfo.frequency.value=0.13;
  const lfoG=audioCtx.createGain();lfoG.gain.value=0.22;
  lfo.connect(lfoG);lfoG.connect(ambWind.gain);
  wind.connect(wf);wf.connect(ambWind);ambWind.connect(ambGain);
  wind.start();lfo.start();
  // cigales discrètes
  const cig=audioCtx.createBufferSource();cig.buffer=nb;cig.loop=true;
  const cf=audioCtx.createBiquadFilter();cf.type='bandpass';cf.frequency.value=4300;cf.Q.value=9;
  ambCig=audioCtx.createGain();ambCig.gain.value=0.11;
  const trem=audioCtx.createOscillator();trem.frequency.value=27;
  const tremG=audioCtx.createGain();tremG.gain.value=0.09;
  trem.connect(tremG);tremG.connect(ambCig.gain);
  const slow=audioCtx.createOscillator();slow.frequency.value=0.07;
  const slowG=audioCtx.createGain();slowG.gain.value=0.05;
  slow.connect(slowG);slowG.connect(ambCig.gain);
  cig.connect(cf);cf.connect(ambCig);ambCig.connect(ambGain);
  cig.start();trem.start();slow.start();
}
/* ambiance par pièce : extérieur vivant, intérieur feutré */
let ambWind=null,ambCig=null,birdTimer=null;
const ROOM_TONES={facade:{w:.5,c:.11,b:.35},terrasse:{w:.55,c:.13,b:1},salon:{w:.28,c:.05,b:0},bureau:{w:.1,c:.012,b:0},_def:{w:.24,c:.03,b:0}};
function setRoomTone(id){
  if(!audioCtx)return;
  const p=ROOM_TONES[id]||ROOM_TONES._def,t=audioCtx.currentTime;
  if(ambWind)ambWind.gain.setTargetAtTime(p.w,t,1.1);
  if(ambCig)ambCig.gain.setTargetAtTime(p.c,t,1.1);
  birdLoop();
}
function birdChirp(){
  if(!audioCtx)return;
  const t0=audioCtx.currentTime,n=2+Math.floor(Math.random()*3);
  for(let i=0;i<n;i++){
    const o=audioCtx.createOscillator(),g=audioCtx.createGain();
    const st=t0+i*(0.14+Math.random()*0.08),f=2600+Math.random()*900;
    o.frequency.setValueAtTime(f,st);
    o.frequency.exponentialRampToValueAtTime(f*1.35,st+0.06);
    o.frequency.exponentialRampToValueAtTime(f*0.9,st+0.12);
    g.gain.setValueAtTime(0.0001,st);
    g.gain.exponentialRampToValueAtTime(0.045,st+0.02);
    g.gain.exponentialRampToValueAtTime(0.0001,st+0.13);
    o.connect(g);g.connect(masterGain);
    o.start(st);o.stop(st+0.16);
  }
}
function birdLoop(){
  clearTimeout(birdTimer);birdTimer=null;
  const p=ROOM_TONES[xpCur]||ROOM_TONES._def;
  if(!galleryOpen||!soundOn||!p.b||!audioCtx)return;
  birdTimer=setTimeout(()=>{
    if(Math.random()<p.b)birdChirp();
    birdLoop();
  },1800+Math.random()*3800);
}
function ambience(on){
  if(!audioCtx)return;
  if(audioCtx.state==='suspended')audioCtx.resume();
  const t=audioCtx.currentTime;
  ambGain.gain.cancelScheduledValues(t);
  ambGain.gain.setTargetAtTime(on?0.05:0,t,0.8);
}
function footsteps(){
  if(!audioCtx||!soundOn)return;
  if(audioCtx.state==='suspended')audioCtx.resume();
  const t0=audioCtx.currentTime;
  [0,0.34,0.66].forEach((dt,i)=>{
    const src=audioCtx.createBufferSource();src.buffer=noiseBuffer(audioCtx,0.14);
    const f=audioCtx.createBiquadFilter();f.type='lowpass';f.frequency.value=260+Math.random()*80;
    const g=audioCtx.createGain();
    const v=0.16-(i*0.03)+Math.random()*0.02;
    g.gain.setValueAtTime(0.0001,t0+dt);
    g.gain.exponentialRampToValueAtTime(v,t0+dt+0.014);
    g.gain.exponentialRampToValueAtTime(0.0001,t0+dt+0.13);
    src.connect(f);f.connect(g);g.connect(masterGain);
    src.start(t0+dt);src.stop(t0+dt+0.15);
  });
}
