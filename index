/* ============ COMPÉTENCES ============ */
function renderSkills(){
  const grid=document.getElementById('skillsGrid');
  const ed=editorUnlocked;
  grid.innerHTML=SKILLS.map((cat,ci)=>`
    <div>
      <div class="cat-h"><span ${ed?'contenteditable="true"':''} data-cat="${ci}">${esc(cat.cat)}</span>${ed?`<button class="cat-rm" data-catrm="${ci}" aria-label="Supprimer la catégorie ${esc(cat.cat)}">✕</button>`:''}</div>
      <ul>
        ${cat.items.map((it,ii)=>`<li><span ${ed?'contenteditable="true"':''} data-cat="${ci}" data-item="${ii}">${esc(it)}</span>${ed?`<button class="sk-rm" data-itemrm="${ci}:${ii}" aria-label="Retirer ${esc(it)}">✕</button>`:''}</li>`).join('')}
      </ul>
      ${ed?`<button class="sk-add" data-addto="${ci}">+ Ajouter un élément</button>`:''}
    </div>`).join('');
  grid.querySelectorAll('span[data-item]').forEach(el=>el.addEventListener('blur',()=>{SKILLS[el.dataset.cat].items[el.dataset.item]=el.textContent.trim();persistSkills();}));
  grid.querySelectorAll('span[data-cat]:not([data-item])').forEach(el=>el.addEventListener('blur',()=>{SKILLS[el.dataset.cat].cat=el.textContent.trim();persistSkills();}));
  grid.querySelectorAll('[data-itemrm]').forEach(btn=>btn.addEventListener('click',()=>{const[ci,ii]=btn.dataset.itemrm.split(':');SKILLS[ci].items.splice(ii,1);persistSkills();renderSkills();}));
  grid.querySelectorAll('[data-catrm]').forEach(btn=>btn.addEventListener('click',()=>{if(!confirm('Supprimer cette catégorie entière ?'))return;SKILLS.splice(btn.dataset.catrm,1);persistSkills();renderSkills();}));
  grid.querySelectorAll('[data-addto]').forEach(el=>el.addEventListener('click',()=>{const txt=prompt('Nouvel élément :');if(txt&&txt.trim()){SKILLS[el.dataset.addto].items.push(txt.trim());persistSkills();renderSkills();}}));
}
