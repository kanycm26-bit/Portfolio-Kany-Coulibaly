/* ============ LIGHTBOX ============ */
let lbItems=[],lbIdx=0,lbBlob=null;
function dataToBlobUrl(d){
  const i=d.indexOf(',');const mime=d.slice(5,i).replace(';base64','');
  const bin=atob(d.slice(i+1));const arr=new Uint8Array(bin.length);
  for(let j=0;j<bin.length;j++)arr[j]=bin.charCodeAt(j);
  return URL.createObjectURL(new Blob([arr],{type:mime}));
}
function lbShow(){
  const img=document.getElementById('lbImg'),pdf=document.getElementById('lbPdf');
  if(lbBlob){URL.revokeObjectURL(lbBlob);lbBlob=null;}
  const a=lbItems[lbIdx];
  if(a.kind==='pdf'){
    img.style.display='none';pdf.style.display='block';
    lbBlob=dataToBlobUrl(safeSrc(a.src,'pdf'));pdf.src=lbBlob;
  }else{
    pdf.style.display='none';pdf.src='about:blank';img.style.display='block';
    img.src=safeSrc(a.src);img.alt=a.label||'';
  }
  document.getElementById('lbCap').textContent=a.label||'';
  document.getElementById('lbCount').textContent=(lbIdx+1)+' / '+lbItems.length;
}
window.openLightbox=(items,idx)=>{
  if(!items||!items.length)return;
  lbItems=items;lbIdx=Math.max(0,idx||0);
  const lb=document.getElementById('lightbox');
  lb.classList.add('open');
  requestAnimationFrame(()=>lb.classList.add('show'));
  lbShow();
  document.querySelector('.lb-close').focus({preventScroll:true});
};
window.closeLightbox=()=>{
  const lb=document.getElementById('lightbox');
  lb.classList.remove('show');
  setTimeout(()=>{lb.classList.remove('open');document.getElementById('lbPdf').src='about:blank';},320);
};
window.lbMove=dir=>{
  if(!lbItems.length)return;
  lbIdx=(lbIdx+dir+lbItems.length)%lbItems.length;
  lbShow();
};

/* ============ CLAVIER ============ */
addEventListener('keydown',e=>{
  const lb=document.getElementById('lightbox');
  if(lb.classList.contains('open')){
    if(e.key==='Escape')closeLightbox();
    if(e.key==='ArrowRight')lbMove(1);
    if(e.key==='ArrowLeft')lbMove(-1);
    return;
  }
  if(e.key==='Escape'){
    if(document.getElementById('gate').classList.contains('open')){closeGate();return;}
    if(document.getElementById('editor').classList.contains('open')){closeEditor();return;}
    if(panel.classList.contains('open')){closeProject();return;}
    if(galleryOpen){if(introRunning)skipIntro();else closeExplore();}
    return;
  }
  if(!galleryOpen)return;
  if(e.key==='ArrowLeft'&&!panel.classList.contains('open')){e.preventDefault();xpBack();}
});

