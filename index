    p.images.forEach((src,i)=>p.annexes.push({label:'Image '+(i+1),kind:'image',src}));
    migrated=true;
  }
  delete p.images;
});
if(migrated)persistProj();

const prefersRM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const finePtr=matchMedia('(pointer: fine)').matches;

/* ============ LOADER ============ */
let loaderDone=false;
function hideLoader(){
  if(loaderDone)return;loaderDone=true;
  document.getElementById('loader').classList.add('gone');
  document.body.classList.add('loaded');
}
addEventListener('load',()=>setTimeout(hideLoader,700));
setTimeout(hideLoader,2600);

/* ============ DÉFILEMENT FLUIDE (inertie) ============ */
const wrap=document.getElementById('smooth');
const smoothOn=finePtr&&!prefersRM;
let vScroll=0;
function setBodyH(){
  if(!smoothOn){document.body.style.height='';return;}
  document.body.style.height=wrap.scrollHeight+'px';
}
if(smoothOn){
  wrap.style.position='fixed';wrap.style.top='0';wrap.style.left='0';wrap.style.right='0';wrap.style.willChange='transform';
  setBodyH();
  addEventListener('resize',setBodyH);
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(setBodyH);
  setTimeout(setBodyH,1500);
}
const docTop=el=>el.getBoundingClientRect().top+(smoothOn?vScroll:scrollY);
window.goTo=id=>{
  const el=document.getElementById(id);if(!el)return;
  const off=innerWidth<=820?54:0;
  const y=Math.max(0,docTop(el)-off);
  scrollTo({top:y,behavior:'auto'});
};

/* scrollspy */
const navA=[...document.querySelectorAll('nav a[data-sec]')];
const secs=navA.map(a=>document.getElementById(a.dataset.sec)).filter(Boolean);
function spy(){
  if(galleryOpen)return;
  const pos=(smoothOn?vScroll:scrollY)+160;
  let cur=secs[0];
  secs.forEach(s=>{if(pos>=docTop(s))cur=s;});
  navA.forEach(a=>a.classList.toggle('active',a.dataset.sec===cur.id));
}
addEventListener('scroll',spy,{passive:true});

/* ============ RÉVÉLATIONS AU SCROLL ============ */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:0.12});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

/* marquee : duplication pour boucle fluide */
