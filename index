function paintPlaceholder(v){
  const W=1600,H=1000,c=document.createElement('canvas');c.width=W;c.height=H;const x=c.getContext('2d');
  const px=p=>p*W/100,py=p=>p*H/100,P=PALETTE;
  const lg=(x1,y1,x2,y2,stops)=>{const g=x.createLinearGradient(x1,y1,x2,y2);stops.forEach(s=>g.addColorStop(s[0],s[1]));return g;};
  const poly=(pts,col)=>{x.fillStyle=col;x.beginPath();pts.forEach((pt,i)=>i?x.lineTo(px(pt[0]),py(pt[1])):x.moveTo(px(pt[0]),py(pt[1])));x.closePath();x.fill();};
  if(v.id==='facade'){
    x.fillStyle=lg(0,0,0,H,[[0,'#F7F1E4'],[0.55,P.sable],[1,'#E3D8C0']]);x.fillRect(0,0,W,H);
    const rg=x.createRadialGradient(px(76),py(16),10,px(76),py(16),260);rg.addColorStop(0,'rgba(232,200,168,.85)');rg.addColorStop(1,'rgba(232,200,168,0)');x.fillStyle=rg;x.fillRect(0,0,W,H);
    poly([[0,78],[100,78],[100,100],[0,100]],'#DACEB5');
    poly([[16,34],[84,34],[84,78],[16,78]],P.mur);
    poly([[12,34],[50,17],[88,34]],P.terra);
