<!DOCTYPE html>
<html lang="fr"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kany Coulibaly — Portfolio · Génie Civil &amp; Construction Durable</title>
<meta name="description" content="Portfolio de fin de BUT Génie Civil &amp; Construction Durable — Kany Coulibaly. Villa interactive 3D, projets SAÉ, compétences et bilan.">
<style>
/* Polices embarquées (Cormorant Garamond + DM Sans) — fonctionne 100 % hors ligne */
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:300 700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
@font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:300 700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
@font-face{font-family:'DM Sans';font-style:normal;font-weight:100 1000;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
@font-face{font-family:'DM Sans';font-style:italic;font-weight:100 1000;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
</style>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --sand:#B7A788;--sand-light:#DCD0B8;--sand-pale:#EDE7DD;--sand-dark:#6B5636;
  --terra:#A8552E;--terra-ink:#8A3F1D;--patina:#6E8271;--dark:#1C1510;--ink:#171009;
  --text:#2D1F14;--text-muted:#6B5B4B;--white:#FBF8F2;--paper:#F5F0E6;--line:rgba(183,167,136,.35);
  --serif:'Cormorant Garamond',serif;--sans:'DM Sans',sans-serif;
  --ease-out:cubic-bezier(.22,.9,.24,1);--ease-soft:cubic-bezier(.4,0,.2,1);
}
html,body{height:auto;}
body{font-family:var(--sans);background:var(--white);color:var(--text);overflow-x:hidden;-webkit-font-smoothing:antialiased;}
::selection{background:var(--terra);color:var(--white);}
img{display:block;max-width:100%;}
button{font-family:var(--sans);}
:focus-visible{outline:2px solid var(--terra);outline-offset:3px;border-radius:2px;}
.skip-link{position:fixed;top:-60px;left:1rem;z-index:200;background:var(--ink);color:var(--white);padding:.7rem 1.2rem;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:top .25s;}
.skip-link:focus{top:1rem;}

/* ===== LOADER ===== */
#loader{position:fixed;inset:0;z-index:300;background:var(--ink);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;transition:clip-path 1s var(--ease-out);clip-path:inset(0 0 0 0);}
#loader.gone{clip-path:inset(0 0 100% 0);pointer-events:none;}
.ld-name{font-family:var(--serif);font-weight:300;font-size:clamp(1.6rem,4vw,2.6rem);color:var(--sand-pale);letter-spacing:.04em;overflow:hidden;}
.ld-name span{display:inline-block;transform:translateY(110%);animation:ldUp .9s var(--ease-out) .15s forwards;}
.ld-sub{font-size:.62rem;letter-spacing:.32em;text-transform:uppercase;color:var(--sand);opacity:0;animation:ldFade .8s ease .6s forwards;}
.ld-bar{width:120px;height:1px;background:rgba(183,167,136,.25);overflow:hidden;}
.ld-bar i{display:block;height:100%;width:100%;background:var(--terra);transform:translateX(-100%);animation:ldBar 1.4s var(--ease-soft) .2s forwards;}
@keyframes ldUp{to{transform:translateY(0);}}
@keyframes ldFade{to{opacity:1;}}
@keyframes ldBar{to{transform:translateX(0);}}

/* ===== NAV ===== */
nav{position:fixed;top:0;left:0;bottom:0;width:180px;z-index:40;display:flex;flex-direction:column;justify-content:space-between;padding:2.4rem 1.6rem;background:rgba(251,248,242,.9);backdrop-filter:blur(14px);border-right:.5px solid var(--line);}
.nav-logo{font-family:var(--serif);font-size:1.15rem;font-weight:500;letter-spacing:.03em;color:var(--terra-ink);line-height:1.25;cursor:pointer;border:none;background:none;text-align:left;padding:0;}
.nav-logo em{font-style:italic;}
nav ul{list-style:none;display:flex;flex-direction:column;gap:1.15rem;flex:1;justify-content:center;}
nav ul a{display:flex;align-items:baseline;gap:.55rem;text-decoration:none;font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;color:var(--text-muted);cursor:pointer;transition:color .25s;border:none;background:none;padding:0;}
nav ul a .n-idx{font-family:var(--serif);font-style:italic;font-size:.68rem;color:var(--sand);transition:color .25s;min-width:1.1rem;}
nav ul a:hover,nav ul a.active{color:var(--terra-ink);}
nav ul a:hover .n-idx,nav ul a.active .n-idx{color:var(--terra);}
.nav-foot{display:flex;flex-direction:column;gap:.7rem;}
.nav-print{display:flex;align-items:center;gap:.5rem;background:none;border:.5px solid var(--line);color:var(--text-muted);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;padding:.55rem .8rem;cursor:pointer;transition:all .25s;}
.nav-print:hover{border-color:var(--terra);color:var(--terra-ink);}
.nav-copy{font-size:.58rem;letter-spacing:.12em;color:var(--sand);text-transform:uppercase;}

/* ===== LAYOUT / CHAPTERS ===== */
#smooth{position:relative;}
.page{margin-left:180px;}
section.block{padding:7rem 5rem 6rem;position:relative;}
.chapter-head{display:flex;align-items:flex-start;gap:2rem;margin-bottom:4rem;}
.ch-num{font-family:var(--serif);font-weight:300;font-style:italic;font-size:clamp(3.2rem,6vw,5.2rem);line-height:.85;color:transparent;-webkit-text-stroke:1px var(--sand);flex-shrink:0;transform:translateY(.35rem);}
.ch-meta{flex:1;min-width:0;}
.sec-tag{font-size:.68rem;letter-spacing:.24em;text-transform:uppercase;color:var(--terra-ink);display:flex;align-items:center;gap:.8rem;margin-bottom:1.1rem;}
.sec-tag::before{content:'';width:26px;height:.5px;background:var(--terra);}
.block h2{font-family:var(--serif);font-size:clamp(2.2rem,4.4vw,3.6rem);font-weight:300;color:var(--ink);line-height:1.08;letter-spacing:-.01em;}
.block h2 em{font-style:italic;color:var(--terra);}
.lede{max-width:560px;font-size:.95rem;line-height:1.9;color:var(--text-muted);margin-top:1.4rem;}

/* reveal */
.rv{opacity:0;transform:translateY(34px);transition:opacity .9s var(--ease-out),transform .9s var(--ease-out);transition-delay:var(--d,0s);}
.rv.in{opacity:1;transform:none;}

/* ===== HERO / VILLA ===== */
#villa{position:relative;height:100vh;min-height:620px;overflow:hidden;background:#EDE3CE;}
.hero-3d{position:absolute;inset:0;background:#EDE7DD;}
.hero-img{display:block;width:100%;height:100%;object-fit:cover;}
.hero-veil{position:absolute;left:0;right:0;bottom:0;height:38%;background:linear-gradient(180deg,rgba(251,248,242,0) 0%,rgba(251,248,242,.86) 100%);pointer-events:none;}
.hero-ui{position:absolute;inset:0;z-index:8;pointer-events:none;display:flex;flex-direction:column;justify-content:flex-end;padding:0 4.5rem 3.2rem;}
.hero-eyebrow{position:absolute;top:1.7rem;left:50%;transform:translateX(-50%);z-index:9;font-size:.64rem;letter-spacing:.3em;text-transform:uppercase;color:var(--terra-ink);background:rgba(251,248,242,.82);border:.5px solid var(--line);padding:.5rem 1.1rem;backdrop-filter:blur(6px);border-radius:2px;white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
.hero-eyebrow::before{content:'';width:34px;height:.5px;background:var(--terra);}
.hero-title{font-family:var(--serif);font-weight:300;color:var(--ink);font-size:clamp(3.4rem,10.5vw,9rem);line-height:.92;letter-spacing:-.02em;}
.hero-title .ln{display:block;overflow:hidden;padding-bottom:.06em;margin-bottom:-.06em;}
.hero-title .ln>span{display:inline-block;transform:translateY(112%);transition:transform 1.1s var(--ease-out);}
.hero-title .ln:nth-child(2)>span{transition-delay:.12s;}
.hero-title em{font-style:italic;color:var(--terra-ink);}
body.loaded .hero-title .ln>span{transform:translateY(0);}
.hero-sub{max-width:420px;margin-top:1.6rem;font-size:.9rem;line-height:1.8;color:var(--text-muted);opacity:0;transform:translateY(16px);transition:opacity .9s ease .5s,transform .9s var(--ease-out) .5s;}
body.loaded .hero-sub{opacity:1;transform:none;}
.hero-hint{position:absolute;top:5.4rem;left:50%;transform:translateX(-50%);z-index:9;font-size:.66rem;letter-spacing:.06em;color:var(--sand-dark);background:rgba(251,248,242,.78);border:.5px solid var(--line);padding:.5rem 1rem;backdrop-filter:blur(6px);transition:opacity .5s;text-align:center;max-width:88vw;pointer-events:none;}
.hero-tools{position:absolute;top:5.2rem;right:2rem;z-index:10;display:flex;gap:.4rem;}
.hero-tools button,.hero-tools label{width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:rgba(251,248,242,.92);border:.5px solid var(--sand);color:var(--terra-ink);font-size:1rem;cursor:pointer;backdrop-filter:blur(4px);border-radius:2px;transition:background .2s,color .2s;font-family:var(--sans);}
.hero-tools button:hover,.hero-tools label:hover{background:var(--white);}
.hero-tools button.on{background:var(--terra);color:var(--white);border-color:var(--terra);}
.hero-tools label input{display:none;}
.enter-btn{pointer-events:auto;position:absolute;bottom:3.4rem;right:4.5rem;z-index:10;display:inline-flex;align-items:center;gap:.9rem;padding:1rem 2rem;background:var(--terra);color:var(--white);border:none;cursor:pointer;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;transition:background .25s,transform .25s var(--ease-out);}
.enter-btn:hover{background:var(--terra-ink);transform:translateY(-2px);}
.enter-btn .arr{transition:transform .3s var(--ease-out);}
.enter-btn:hover .arr{transform:translateX(4px);}
.scroll-cue{position:absolute;bottom:1.8rem;left:4.5rem;z-index:9;display:flex;align-items:center;gap:.8rem;font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--text-muted);pointer-events:none;}
.scroll-cue i{display:block;width:1px;height:44px;background:var(--line);position:relative;overflow:hidden;}
.scroll-cue i::after{content:'';position:absolute;left:0;top:-100%;width:100%;height:100%;background:var(--terra);animation:cue 2.2s var(--ease-soft) infinite;}
@keyframes cue{0%{top:-100%;}55%{top:0;}100%{top:100%;}}

/* ===== MARQUEE ===== */
.marquee{overflow:hidden;background:var(--ink);color:var(--sand-pale);padding:1.5rem 0;border-top:.5px solid rgba(183,167,136,.2);}
.mq-track{display:flex;width:max-content;animation:mq 46s linear infinite;}
.marquee:hover .mq-track{animation-play-state:paused;}
.mq-track span{font-family:var(--serif);font-weight:300;font-style:italic;font-size:clamp(1.3rem,2.6vw,2rem);white-space:nowrap;padding-right:3.2rem;display:flex;align-items:center;gap:3.2rem;}
.mq-track span::after{content:'✳';font-style:normal;font-size:.8em;color:var(--terra);}
@keyframes mq{to{transform:translateX(-50%);}}

/* ===== À PROPOS ===== */
#apropos{background:var(--white);}
.about-grid{display:grid;grid-template-columns:1fr;gap:4rem;align-items:start;margin-bottom:5rem;}
.about-text{max-width:780px;}
.photo-frame{position:relative;}
.photo-frame::before{content:'';position:absolute;inset:14px -14px -14px 14px;border:.5px solid var(--sand);z-index:0;}
.photo-ph{position:relative;z-index:1;width:100%;aspect-ratio:3/4;border:.5px solid rgba(183,167,136,.6);background:var(--sand-pale);display:flex;align-items:center;justify-content:center;text-align:center;font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;color:var(--terra-ink);padding:1rem;overflow:hidden;}
.ph-mono{font-family:var(--serif);font-size:4.6rem;font-weight:300;letter-spacing:.04em;color:rgba(122,106,82,.4);text-transform:none;}
.ph-mono em{font-style:italic;color:rgba(168,85,46,.45);}
.photo-ph img{width:100%;height:100%;object-fit:cover;}
.about-text p{font-size:.95rem;line-height:1.95;color:var(--text-muted);margin-bottom:1.2rem;max-width:640px;}
.about-text strong{color:var(--terra-ink);font-weight:500;}
.about-text .sig{font-family:var(--serif);font-style:italic;font-size:1.7rem;color:var(--ink);margin-top:1.6rem;}
.tl-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;}
.tl-h{font-size:.68rem;text-transform:uppercase;letter-spacing:.2em;color:var(--terra-ink);display:flex;align-items:center;gap:.7rem;margin-bottom:1.6rem;}
.tl-h::before{content:'';width:18px;height:.5px;background:var(--terra);}
.tl{border-left:.5px solid var(--line);padding-left:1.8rem;}
.tl-item{position:relative;margin-bottom:2rem;}
.tl-item::before{content:'';position:absolute;left:-2.1rem;top:.4rem;width:7px;height:7px;border-radius:50%;background:var(--patina);transition:transform .3s,background .3s;}
.tl-item:hover::before{transform:scale(1.5);background:var(--terra);}
.tl-date{font-size:.66rem;text-transform:uppercase;letter-spacing:.12em;color:var(--terra-ink);margin-bottom:.25rem;}
.tl-title{font-size:.95rem;font-weight:500;color:var(--ink);}
.tl-place{font-size:.8rem;color:var(--text-muted);margin-top:.15rem;}

/* ===== SOMMAIRE PROJETS ===== */
#projets{background:var(--paper);border-top:.5px solid var(--line);border-bottom:.5px solid var(--line);}
.visit-note{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;margin-bottom:3rem;}
.visit-note p{font-size:.85rem;color:var(--text-muted);max-width:520px;line-height:1.8;}
.visit-3d{display:inline-flex;align-items:center;gap:.8rem;background:none;border:.5px solid var(--terra);color:var(--terra-ink);padding:.85rem 1.6rem;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:all .25s;}
.visit-3d:hover{background:var(--terra);color:var(--white);}
.vlist{border-top:.5px solid var(--line);}
.vrow{display:grid;grid-template-columns:5.5rem 1fr auto;gap:2rem;align-items:center;padding:1.7rem .8rem;border-bottom:.5px solid var(--line);cursor:pointer;background:none;border-left:none;border-right:none;border-top:none;width:100%;text-align:left;position:relative;transition:background .3s,padding .3s var(--ease-out);}
.vrow:hover,.vrow:focus-visible{background:rgba(251,248,242,.9);padding-left:1.6rem;}
.vrow .v-n{font-family:var(--serif);font-style:italic;font-weight:300;font-size:2rem;color:var(--sand);transition:color .3s;}
.vrow:hover .v-n,.vrow:focus-visible .v-n{color:var(--terra);}
.vrow .v-t{font-family:var(--serif);font-size:clamp(1.15rem,2.2vw,1.6rem);font-weight:400;color:var(--ink);line-height:1.2;}
.vrow .v-s{font-size:.76rem;color:var(--text-muted);margin-top:.3rem;letter-spacing:.02em;}
.vrow .v-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.5rem;}
.vrow .v-tags span{font-size:.58rem;text-transform:uppercase;letter-spacing:.1em;padding:.2rem .55rem;border:.5px solid var(--sand);color:var(--terra-ink);}
.vrow .v-go{width:44px;height:44px;border:.5px solid var(--sand);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--terra-ink);font-size:1rem;transition:all .3s var(--ease-out);flex-shrink:0;}
.vrow:hover .v-go,.vrow:focus-visible .v-go{background:var(--terra);border-color:var(--terra);color:var(--white);transform:rotate(-45deg);}

/* ===== COMPÉTENCES ===== */
#competences{background:var(--sand-pale);position:relative;overflow:hidden;}
#competences>*:not(.motif-bg){position:relative;z-index:1;}
.motif-bg{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
.motif-piece{position:absolute;will-change:transform;transition:transform .4s cubic-bezier(.22,.9,.32,1);}
@media(prefers-reduced-motion:no-preference){
  .motif-drift{animation:motifDrift 26s ease-in-out infinite;}
  .motif-drift-b{animation-duration:21s;animation-direction:reverse;}
}
@keyframes motifDrift{0%{transform:translate(0,0) rotate(0deg);}50%{transform:translate(14px,-12px) rotate(6deg);}100%{transform:translate(0,0) rotate(0deg);}}
.skills{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:2.6rem;}
.skills ul{list-style:none;}
.skills li{font-size:.84rem;color:var(--text-muted);padding:.45rem 0;border-bottom:.5px solid rgba(183,167,136,.2);display:flex;align-items:center;gap:.5rem;}
.skills li::before{content:'—';color:var(--patina);font-size:.7rem;}
.skills li span{flex:1;outline:none;}
.skills li span:focus{background:rgba(168,85,46,.08);}
.skills li .sk-rm{opacity:0;border:none;background:none;color:var(--terra);cursor:pointer;font-size:.8rem;line-height:1;padding:0 .2rem;}
.skills li:hover .sk-rm{opacity:1;}
.sk-add{font-size:.72rem;color:var(--terra-ink);cursor:pointer;margin-top:.6rem;display:inline-block;border:none;background:none;text-decoration:underline;text-underline-offset:3px;}
.cat-h{font-size:.72rem;text-transform:uppercase;letter-spacing:.16em;color:var(--terra-ink);border-bottom:.5px solid var(--line);padding-bottom:.8rem;margin-bottom:1.2rem;display:flex;justify-content:space-between;align-items:center;gap:.5rem;font-family:var(--serif);font-style:italic;font-size:1.05rem;text-transform:none;letter-spacing:.02em;}
.cat-h span{outline:none;flex:1;}
.cat-rm{border:none;background:none;color:var(--terra);cursor:pointer;font-size:.75rem;opacity:.55;}
.cat-rm:hover{opacity:1;}
.add-cat{margin-top:1.6rem;background:none;border:1px dashed var(--sand);color:var(--terra-ink);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:.7rem 1.4rem;cursor:pointer;transition:all .25s;}
.add-cat:hover{border-color:var(--terra);background:rgba(168,85,46,.05);}

/* ===== PERSPECTIVES / CONCLUSION ===== */
#perspectives{background:var(--white);position:relative;overflow:hidden;}
#perspectives>*:not(.motif-bg){position:relative;z-index:1;}
.persp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3rem;}
.persp-card{border-top:.5px solid var(--sand);padding-top:1.6rem;transition:border-color .3s;}
.persp-card:hover{border-color:var(--terra);}
.persp-card .tl-h{margin-bottom:1rem;}
.persp-card p{font-size:.88rem;line-height:1.85;color:var(--text-muted);}
#conclusion{background:var(--sand-pale);}
.concl-block p{font-size:.95rem;line-height:1.95;color:var(--text-muted);margin-bottom:1.5rem;max-width:660px;}
.concl-block p:first-of-type::first-letter{font-family:var(--serif);font-size:3.4rem;line-height:1;float:left;padding:.35rem .7rem 0 0;color:var(--terra);}

/* ===== CONTACT ===== */
#contact{background:var(--ink);}
#contact .ch-num{-webkit-text-stroke:1px rgba(183,167,136,.5);}
#contact .sec-tag{color:var(--sand);}#contact .sec-tag::before{background:var(--terra);}
#contact h2{color:var(--white);}#contact h2 em{color:var(--sand);}
.ct-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:5rem;align-items:start;}
.ct-grid .blurb{font-size:1rem;line-height:2;color:rgba(251,248,242,.6);max-width:480px;}
.ct-big{font-family:var(--serif);font-weight:300;font-size:clamp(1.8rem,3.4vw,2.8rem);color:var(--white);line-height:1.25;margin-bottom:2rem;}
.ct-big em{font-style:italic;color:var(--sand);}
.ct-links{display:flex;flex-direction:column;gap:.9rem;}
.ct-link{display:flex;align-items:center;gap:1.1rem;text-decoration:none;color:rgba(251,248,242,.65);font-size:.88rem;padding:1.15rem 1.3rem;border:.5px solid rgba(183,167,136,.25);transition:all .3s var(--ease-out);}
.ct-link:hover{color:var(--white);border-color:var(--sand);background:rgba(183,167,136,.08);transform:translateX(6px);}
.ct-icon{color:var(--patina);min-width:20px;font-style:normal;}
footer{background:var(--ink);border-top:.5px solid rgba(183,167,136,.15);padding:2.2rem 5rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;}
.foot-name{font-family:var(--serif);font-style:italic;color:rgba(251,248,242,.4);font-size:1.05rem;}
.foot-note{font-size:.7rem;color:rgba(251,248,242,.28);letter-spacing:.1em;}

/* ===== FICHE PROJET (panneau) ===== */
#sheetBackdrop{position:fixed;inset:0;z-index:55;background:rgba(23,16,9,.55);backdrop-filter:blur(4px);opacity:0;visibility:hidden;transition:opacity .45s ease,visibility .45s;}
#sheetBackdrop.open{opacity:1;visibility:visible;}
.panel{position:fixed;top:0;right:0;bottom:0;width:min(460px,94vw);z-index:60;background:var(--white);border-left:.5px solid var(--line);padding:2.6rem 2.2rem 3rem;overflow-y:auto;transform:translateX(103%);transition:transform .55s var(--ease-out);box-shadow:-24px 0 60px rgba(23,16,9,.14);}
.panel.open{transform:translateX(0);}
.panel>*{opacity:0;transform:translateY(14px);transition:opacity .5s ease,transform .5s var(--ease-out);}
.panel.open>*{opacity:1;transform:none;}
.panel.open>*:nth-child(1){transition-delay:.08s}.panel.open>*:nth-child(2){transition-delay:.13s}.panel.open>*:nth-child(3){transition-delay:.18s}.panel.open>*:nth-child(4){transition-delay:.23s}.panel.open>*:nth-child(5){transition-delay:.28s}.panel.open>*:nth-child(6){transition-delay:.33s}.panel.open>*:nth-child(7){transition-delay:.38s}
.p-top{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;}
.p-num{font-family:var(--serif);font-size:3.6rem;font-weight:300;font-style:italic;color:transparent;-webkit-text-stroke:1px var(--sand);line-height:1;}
.p-x{width:38px;height:38px;border:.5px solid var(--line);background:none;color:var(--terra-ink);font-size:1.05rem;cursor:pointer;border-radius:50%;transition:all .25s;flex-shrink:0;}
.p-x:hover{background:var(--terra);border-color:var(--terra);color:var(--white);transform:rotate(90deg);}
.p-tags{display:flex;flex-wrap:wrap;gap:.5rem;margin:.9rem 0 1rem;}
.p-tags span{font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;padding:.28rem .7rem;border:.5px solid var(--sand);color:var(--terra-ink);}
.panel h3{font-family:var(--serif);font-size:1.85rem;font-weight:400;color:var(--ink);line-height:1.15;margin-bottom:.4rem;}
.p-sub2{font-size:.78rem;letter-spacing:.04em;color:var(--patina);font-style:italic;font-family:var(--serif);font-size:1rem;margin-bottom:1.1rem;}
.p-desc{font-size:.88rem;line-height:1.85;color:var(--text-muted);margin-bottom:1.6rem;}
.p-sec{font-size:.62rem;text-transform:uppercase;letter-spacing:.16em;color:var(--terra-ink);border-bottom:.5px solid var(--line);padding-bottom:.45rem;margin:1.6rem 0 .9rem;display:flex;justify-content:space-between;align-items:center;}
.p-card-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;}
.p-card{background:var(--paper);border:.5px solid rgba(183,167,136,.4);padding:.75rem .85rem;}
.p-card-h{font-size:.58rem;text-transform:uppercase;letter-spacing:.1em;color:var(--terra-ink);margin-bottom:.35rem;}
.p-card p{font-size:.74rem;line-height:1.6;color:var(--text-muted);outline:none;}
.p-card p:focus{background:rgba(168,85,46,.07);}
.p-swot{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:rgba(183,167,136,.35);border:.5px solid var(--line);}
.p-swot-cell{background:var(--white);padding:.75rem .85rem;}
.p-swot-cell p{font-size:.74rem;line-height:1.6;color:var(--text-muted);outline:none;}
/* annexes */
.anx-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;}
.anx{position:relative;aspect-ratio:1;border:.5px solid var(--line);overflow:hidden;cursor:pointer;background:var(--sand-pale);padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;transition:border-color .25s,transform .25s var(--ease-out);width:100%;}
.anx:hover{border-color:var(--terra);transform:translateY(-2px);}
.anx img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.anx .anx-kind{font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--terra-ink);}
.anx .anx-lbl{font-size:.6rem;color:var(--text-muted);text-align:center;padding:0 .4rem;line-height:1.3;}
.anx-img .anx-lbl{position:absolute;left:0;right:0;bottom:0;background:rgba(23,16,9,.72);color:var(--sand-pale);padding:.3rem .4rem;}
